<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Forced light so the setup screen and dialogs keep the same
         formal look on readers that are set to dark mode. The radar screen draws its own dark UI. -->
    <style name="Base.Theme.RFID" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hc_navy_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/hc_navy_600</item>
        <item name="colorSecondary">@color/hc_gold</item>
        <item name="colorOnSecondary">@color/hc_navy_900</item>
        <item name="colorSurface">@color/hc_surface</item>
        <item name="colorOnSurface">@color/hc_text</item>
        <item name="colorOutline">@color/hc_outline</item>
        <item name="android:colorBackground">@color/hc_ivory</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.RFID" parent="Base.Theme.RFID" />

    <!-- Radar screen: dark navy, light system bar icons -->
    <style name="Theme.RFID.Radar" parent="Base.Theme.RFID">
        <item name="android:windowBackground">@color/hc_navy_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- Base style namespace for HC styles -->
    <style name="HC" />

    <!-- Shared text styles -->
    <style name="HC.SectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/hc_text_muted</item>
    </style>

    <style name="HC.SectionLabel.Dark">
        <item name="android:textColor">@color/hc_text_on_dark_muted</item>
    </style>

    <style name="HC.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/hc_surface</item>
        <item name="strokeColor">@color/hc_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="HC.Card.Dark">
        <item name="cardBackgroundColor">@color/hc_navy_800</item>
        <item name="strokeColor">@color/hc_navy_line</item>
    </style>
</resources>
