<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Same as the day theme on purpose: the app keeps one consistent court look. -->
    <style name="Base.Theme.RFID" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hc_navy_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/hc_navy_600</item>
        <item name="colorSecondary">@color/hc_gold</item>
        <item name="colorOnSecondary">@color/hc_navy_900</item>
        <item name="colorSurface">@color/hc_surface</item>
        <item name="colorOnSurface">@color/hc_text</item>
        <item name="colorOutline">@color/hc_outline</item>
        <item name="android:colorBackground">@color/hc_ivory</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
