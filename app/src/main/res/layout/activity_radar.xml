<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Back"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Native File Locator"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_mute"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Audio On"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155" />
    </LinearLayout>

    <!-- File Target Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tv_file_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_file_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_case_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_storage_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Direction Guidance Pill -->
    <TextView
        android:id="@+id/tv_guidance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="10dp"
        android:gravity="center"
        android:background="#334155"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="HOLD TRIGGER &amp; SWEEP AROUND ROOM" />

    <!-- 60 FPS GPU-Accelerated Radar View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <com.example.rfid.RadarView
            android:id="@+id/radar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- REC circle: saves one reading. LOG: shows / copies the saved readings. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/btn_rec"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_rec_circle"
                android:gravity="center"
                android:text="REC"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_log"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_log_pill"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="LOG\n0"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Diagnostics: tap the title or the file name to show or hide -->
        <TextView
            android:id="@+id/tv_debug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="#B3000000"
            android:padding="6dp"
            android:fontFamily="monospace"
            android:textColor="#FACC15"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Signal Bar & Readout -->
    <ProgressBar
        android:id="@+id/pb_signal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#22C55E"
        android:backgroundTint="#334155" />

    <TextView
        android:id="@+id/tv_signal_readout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Ready - pull trigger to scan"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <!-- Reader power: lower = more accurate direction, higher = longer range -->
    <TextView
        android:id="@+id/tv_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Reader power"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/sb_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="25"
        android:progress="15"
        android:progressTint="#22C55E"
        android:thumbTint="#22C55E" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lower power: more accurate direction. Higher power: longer range."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_calibrate"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Calibrate distance"
        android:textColor="#38BDF8"
        android:textSize="13sp" />

</LinearLayout>